{
    "version": 3,
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Release build, Qt from the system or from TuxAPE's .deps/",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "${sourceDir}/../TuxAPE/.deps/qt6/usr"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
    ]
}
